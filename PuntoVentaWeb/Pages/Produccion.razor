@page "/produccion"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject ProduccionService ProduccionService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="produccion-container p-3 p-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark m-0">
                <i class="bi bi-fire text-danger me-2"></i>Módulo de Producción
            </h3>
            <span class="text-muted small">Captura múltiples productos en lote y descuenta sus insumos consolidados</span>
        </div>
        <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick='() => Nav.NavigateTo("/ventas")'>
            <i class="bi bi-cart3 me-1"></i> Ir al Punto de Venta
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="mt-2 text-muted fw-semibold">Cargando catálogo de producción...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* --- COLUMNA IZQUIERDA: FORMULARIO Y LISTA DE PRODUCCIÓN --- *@
            <div class="col-12 col-lg-6">
                <!-- PANEL 1: SELECCIÓN RÁPIDA Y PRODUCTOR -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                        <h5 class="m-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Agregar Producto a la Tanda</h5>
                    </div>
                    <div class="card-body p-3">
                        @* --- Selector de Productor / Usuario --- *@
                        <div class="mb-3 p-2 bg-light rounded border">
                            <label class="form-label fw-bold small text-dark mb-1">
                                <i class="bi bi-person-badge me-1"></i>Productor / Encargado:
                            </label>
                            <select class="form-select fw-semibold" @bind="usuarioSeleccionado">
                                @foreach (var usr in listaUsuarios)
                                {
                                    <option value="@usr">@usr</option>
                                }
                            </select>
                        </div>

                        <div class="row g-3 align-items-end">
                            @* --- Selector de producto --- *@
                            @* --- Buscador Dinámico de Producto --- *@
                            <div class="col-12 col-md-5 position-relative">
                                <label class="form-label fw-bold small mb-1">Producto Elaborado:</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text"
                                           class="form-control fw-semibold"
                                           placeholder="Buscar producto por nombre..."
                                           @bind="busquedaProducto"
                                           @bind:event="oninput"
                                           @onkeyup="FiltrarProductosEnTiempoReal"
                                           @onfocus="MostrarListaCompleta" />
                                    @if (!string.IsNullOrEmpty(busquedaProducto))
                                    {
                                        <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarSeleccionProducto">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>

                                @* --- Lista desplegable flotante de resultados --- *@
                                @if (mostrarListaProductos && productosFiltrados.Any())
                                {
                                    <div class="list-group position-absolute w-100 shadow-lg rounded-3 mt-1 overflow-auto"
                                         style="max-height: 250px; z-index: 1050; background: white;">
                                        @foreach (var prod in productosFiltrados)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-2"
                                                    @onclick="() => SeleccionarProducto(prod)">
                                                <div>
                                                    <div class="fw-bold text-dark">@prod.Nombre</div>
                                                    <small class="text-muted">Stock actual: @prod.Existencia pz</small>
                                                </div>
                                                <span class="badge bg-light text-dark border">ID: @prod.Id</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (mostrarListaProductos && !productosFiltrados.Any())
                                {
                                    <div class="position-absolute w-100 shadow-lg rounded-3 mt-1 p-3 bg-white text-muted text-center"
                                         style="z-index: 1050;">
                                        <small>No se encontraron productos que coincidan</small>
                                    </div>
                                }
                            </div>
                            @* --- Input de piezas con botones + y - --- *@
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small mb-1">Piezas:</label>
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary fw-bold"
                                            type="button"
                                            disabled="@(productoSeleccionado == null || cantidadInput <= 1)"
                                            @onclick="() => ModificarCantidadInput(-1)">
                                        -
                                    </button>

                                    <input type="number"
                                           class="form-control text-center fw-bold text-danger"
                                           min="1"
                                           step="1"
                                           @bind="cantidadInput"
                                           disabled="@(productoSeleccionado == null)" />

                                    <button class="btn btn-outline-secondary fw-bold"
                                            type="button"
                                            disabled="@(productoSeleccionado == null)"
                                            @onclick="() => ModificarCantidadInput(1)">
                                        +
                                    </button>
                                </div>
                            </div>

                            @* --- Botón Agregar explícito --- *@
                            <div class="col-12 col-md-3">
                                <button class="btn btn-danger w-100 fw-bold d-flex align-items-center justify-content-center gap-1"
                                        style="height: 38px;"
                                        disabled="@(productoSeleccionado == null || cantidadInput <= 0)"
                                        @onclick="AgregarAListaProduccion">
                                    <i class="bi bi-plus-lg"></i>
                                    <span>Agregar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PANEL 2: TABLA DE PRODUCTOS EN LA TANDA -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="m-0 fw-bold text-dark"><i class="bi bi-list-check me-2"></i>Piezas a Producir</h5>
                        @if (listaProduccion.Count > 0)
                        {
                            <span class="badge bg-danger fs-6">@listaProduccion.Sum(x => x.CantidadProducida) Piezas Totales</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        @if (listaProduccion.Count == 0)
                        {
                            <div class="text-center py-5 text-muted p-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <h6>La lista de producción está vacía.</h6>
                                <p class="small text-muted mb-0">Selecciona un producto arriba para comenzar a armar la hornada.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-center">Stock Actual</th>
                                            <th class="text-center">A Producir</th>
                                            <th class="text-center">Nuevo Stock</th>
                                            <th class="text-end">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in listaProduccion)
                                        {
                                            <tr>
                                                <td class="fw-bold">@item.NombreProductoFinal</td>
                                                <td class="text-center text-muted">@item.StockActual pz</td>
                                                <td class="text-center fw-bold text-danger fs-6">@item.CantidadProducida pz</td>
                                                <td class="text-center fw-bold text-success">@(item.StockActual + item.CantidadProducida) pz</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarDeListaProduccion(item)">X</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white p-3">
                        <button class="btn btn-danger btn-lg w-100 fw-bold shadow"
                                disabled="@(listaProduccion.Count == 0 || guardando)"
                                @onclick="ConfirmarProduccionLote">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Procesando Lote de Producción...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                                <span>Procesar Toda la Tanda (@listaProduccion.Count productos) por @usuarioSeleccionado</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            @* --- COLUMNA DERECHA: CONSOLIDADO GLOBAL DE INSUMOS --- *@
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="m-0 fw-bold text-dark"><i class="bi bi-box-seam me-2"></i>Consolidado Total de Insumos</h5>
                        @if (insumosConsolidados.Count > 0)
                        {
                            <span class="badge bg-secondary">@insumosConsolidados.Count Insumos Únicos</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        @if (listaProduccion.Count == 0)
                        {
                            <div class="text-center py-5 text-muted p-4">
                                <i class="bi bi-calculator fs-1 d-block mb-2 text-danger"></i>
                                <h5>Agrega productos para calcular el consumo global de materia prima</h5>
                            </div>
                        }
                        else if (insumosConsolidados.Count == 0)
                        {
                            <div class="text-center py-5 text-warning p-4">
                                <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
                                <h5>Los productos seleccionados no tienen recetas asociadas</h5>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Insumo</th>
                                            <th class="text-center">Total a Descontar</th>
                                            <th class="text-end">Stock Actual</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ins in insumosConsolidados)
                                        {
                                            <tr class="@(!ins.StockSuficiente ? "table-danger" : "")">
                                                <td class="fw-bold">@ins.NombreInsumo</td>
                                                <td class="text-center fw-bold text-danger fs-6">
                                                    @ins.CantidadTotalRequerida.ToString("0.###") @ins.Unidad
                                                </td>
                                                <td class="text-end">@ins.StockActual.ToString("0.###") @ins.Unidad</td>
                                                <td class="text-center">
                                                    @if (ins.StockSuficiente)
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> OK</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Faltante</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .produccion-container {
        min-height: 100vh;
        background-color: #f8f9fa;
    }
</style>

@code {
    private string idProductoSeleccionado = "";
    private double cantidadInput = 1;

    private bool cargando = true;
    private bool guardando = false;

    private List<string> listaUsuarios = new();
    private string usuarioSeleccionado = "Administrador";

    private List<ProductoVenta> productosElaborados = new();
    private ProductoVenta? productoSeleccionado;
    // Variables para el buscador dinámico de producto
    private string busquedaProducto = "";
    private bool mostrarListaProductos = false;
    private List<ProductoVenta> productosFiltrados = new();

    // Filtrado en tiempo real al escribir
    private void FiltrarProductosEnTiempoReal()
    {
        if (string.IsNullOrWhiteSpace(busquedaProducto))
        {
            productosFiltrados = productosElaborados.ToList();
            mostrarListaProductos = true;
        }
        else
        {
            productosFiltrados = productosElaborados
                .Where(p => p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase))
                .ToList();
            mostrarListaProductos = true;
        }
    }

    // Mostrar todas las opciones al hacer clic / Focus en el input
    private void MostrarListaCompleta()
    {
        if (string.IsNullOrWhiteSpace(busquedaProducto))
        {
            productosFiltrados = productosElaborados.ToList();
        }
        mostrarListaProductos = true;
    }

    // Seleccionar un producto de la lista flotante
    private void SeleccionarProducto(ProductoVenta prod)
    {
        productoSeleccionado = prod;
        idProductoSeleccionado = prod.Id;
        busquedaProducto = prod.Nombre;
        mostrarListaProductos = false;
    }

    // Limpiar la selección actual
    private void LimpiarSeleccionProducto()
    {
        busquedaProducto = "";
        productoSeleccionado = null;
        idProductoSeleccionado = "";
        mostrarListaProductos = false;
    }
    public class ItemProduccionLocal
    {
        public string IdProductoFinal { get; set; } = "";
        public string NombreProductoFinal { get; set; } = "";
        public double CantidadProducida { get; set; }
        public double StockActual { get; set; }
    }

    private List<ItemProduccionLocal> listaProduccion = new();
    private List<InsumoDesgloseDto> insumosConsolidados = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
        await CargarProductosElaborados();
    }

    private async Task CargarUsuarios()
    {
        try
        {
            listaUsuarios = await ProduccionService.ObtenerUsuariosAsync();
            if (listaUsuarios.Any() && !listaUsuarios.Contains(usuarioSeleccionado))
            {
                usuarioSeleccionado = listaUsuarios.First();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar usuarios: {ex.Message}");
        }
    }

    private async Task CargarProductosElaborados()
    {
        cargando = true;
        try
        {
            productosElaborados = await ProduccionService.ObtenerProductosElaboradosAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar lista de productos: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void ModificarCantidadInput(double delta)
    {
        cantidadInput = Math.Max(1, cantidadInput + delta);
    }

    private async Task AgregarAListaProduccion()
    {
        if (productoSeleccionado == null || cantidadInput <= 0) return;

        var existente = listaProduccion.FirstOrDefault(x => x.IdProductoFinal == productoSeleccionado.Id);
        if (existente != null)
        {
            existente.CantidadProducida += cantidadInput;
        }
        else
        {
            listaProduccion.Add(new ItemProduccionLocal
            {
                IdProductoFinal = productoSeleccionado.Id,
                NombreProductoFinal = productoSeleccionado.Nombre,
                CantidadProducida = cantidadInput,
                StockActual = productoSeleccionado.Existencia
            });
        }

        idProductoSeleccionado = "";
        productoSeleccionado = null;
        cantidadInput = 1;

        await RecalcularConsolidadoInsumos();
    }

    private void OnProductoSeleccionado(ChangeEventArgs e)
    {
        idProductoSeleccionado = e.Value?.ToString() ?? "";
        productoSeleccionado = productosElaborados.FirstOrDefault(x => x.Id == idProductoSeleccionado);
    }

    private async Task EliminarDeListaProduccion(ItemProduccionLocal item)
    {
        listaProduccion.Remove(item);
        await RecalcularConsolidadoInsumos();
    }

    private async Task RecalcularConsolidadoInsumos()
    {
        insumosConsolidados.Clear();
        if (listaProduccion.Count == 0) return;

        try
        {
            var mapaInsumos = new Dictionary<string, InsumoDesgloseDto>();

            foreach (var item in listaProduccion)
            {
                var insumosProducto = await ProduccionService.ObtenerDesgloseInsumosAsync(item.IdProductoFinal, item.CantidadProducida);

                foreach (var ins in insumosProducto)
                {
                    if (mapaInsumos.ContainsKey(ins.IdInsumo))
                    {
                        mapaInsumos[ins.IdInsumo].CantidadTotalRequerida += ins.CantidadTotalRequerida;
                    }
                    else
                    {
                        mapaInsumos[ins.IdInsumo] = new InsumoDesgloseDto
                        {
                            IdInsumo = ins.IdInsumo,
                            NombreInsumo = ins.NombreInsumo,
                            Unidad = ins.Unidad,
                            CantidadUnitaria = ins.CantidadUnitaria,
                            CantidadTotalRequerida = ins.CantidadTotalRequerida,
                            StockActual = ins.StockActual
                        };
                    }
                }
            }

            insumosConsolidados = mapaInsumos.Values.ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al consolidar insumos: {ex.Message}");
        }
    }

    private async Task ConfirmarProduccionLote()
    {
        if (listaProduccion.Count == 0) return;

        bool hayFaltantes = insumosConsolidados.Any(x => !x.StockSuficiente);
        string advertencia = hayFaltantes
            ? "\n\n⚠️ ATENCIÓN: Hay insumos faltantes en inventario. La existencia quedará en números negativos."
            : "";

        double totalPiezas = listaProduccion.Sum(x => x.CantidadProducida);

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Confirmas el procesamiento de {listaProduccion.Count} productos ({totalPiezas} piezas en total) producidos por '{usuarioSeleccionado}'?{advertencia}\nSe actualizará el inventario y se descontarán los insumos consolidados.");

        if (!confirmado) return;

        guardando = true;
        try
        {
            int procesadosOk = 0;

            foreach (var item in listaProduccion)
            {
                var insumosIndividuales = await ProduccionService.ObtenerDesgloseInsumosAsync(item.IdProductoFinal, item.CantidadProducida);

                var req = new ProduccionRequest
                {
                    IdProductoFinal = item.IdProductoFinal,
                    NombreProductoFinal = item.NombreProductoFinal,
                    CantidadProducida = item.CantidadProducida,
                    Usuario = usuarioSeleccionado, // <--- Pasa el usuario seleccionado dinámicamente
                    InsumosAfectados = insumosIndividuales
                };

                var res = await ProduccionService.RegistrarProduccionLoteAsync(req);
                if (res.Exito) procesadosOk++;
            }

            if (procesadosOk > 0)
            {
                await JS.InvokeVoidAsync("alert", $"¡Lote de producción procesado exitosamente por {usuarioSeleccionado}!\nSe registraron {procesadosOk} productos y se actualizaron sus inventarios.");

                listaProduccion.Clear();
                insumosConsolidados.Clear();
                await CargarProductosElaborados();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ocurrió un error inesperado durante el procesamiento: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }
}