    private void FiltrarClientes()
    {
        if (string.IsNullOrWhiteSpace(busquedaCliente))
        {
            listaClientesFiltrados = listaClientes;
        }
        else
        {
            listaClientesFiltrados = listaClientes.Where(c =>
                c.Nombre.Contains(busquedaCliente, StringComparison.OrdinalIgnoreCase) ||
                (c.Telefono ?? "").Contains(busquedaCliente, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

