@page "/ventas"
@page "/ventas/{ModoInicial}"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject CotizacionService _cotizacionService
@inject VentaService VentaService
@inject ImpresionPosService ImpresionService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="pos-container">
    @* --- HEADER FIJO --- *@
    <div class="sticky-header-group">
        <div class="header-bar">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="badge rounded-pill @BadgeColorModo px-3 py-2 fs-6 shadow-sm">
                        <i class="@IconoModo me-1"></i> @TituloModo
                    </span>

                    <button class="btn btn-sm btn-outline-primary fw-bold bg-white shadow-sm rounded-pill px-3"
                            @onclick="AbrirModalCliente">
                        <i class="bi bi-person-fill text-primary me-1"></i>
                        @(clienteSeleccionado != null ? clienteSeleccionado.Nombre : (modoVenta == "CONTADO" ? "Público en General" : "Seleccionar Cliente *"))
                    </button>

                    @if (clienteSeleccionado != null && modoVenta == "CREDITO")
                    {
                        <span class="badge bg-warning text-dark border">
                            Adeudo: $@clienteSeleccionado.Adeudo.ToString("N2") | Límite: $@clienteSeleccionado.Limite.ToString("N2")
                        </span>
                    }

                    <span class="fw-bold text-dark small bg-light px-2 py-1 rounded border">
                        Estado: <span class="text-success">NUEVA VENTA</span>
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-white"><i class="bi bi-qr-code-scan"></i></span>
                        <input type="text" class="form-control fw-bold" placeholder="Escanear o buscar código..."
                               @bind="textoBusqueda" @bind:event="oninput" @onkeydown="ProcesarBusquedaOEscaneo" autofocus />
                        @if (!string.IsNullOrEmpty(textoBusqueda))
                        {
                            <button class="btn btn-outline-secondary" @onclick="LimpiarBusqueda"><i class="bi bi-x"></i></button>
                        }
                    </div>

                    <button class="btn btn-primary position-relative shadow-sm rounded-pill px-3" @onclick="ToggleCarrito">
                        <i class="bi bi-cart3 fs-5 me-1"></i>
                        <span class="fw-bold d-none d-md-inline">Carrito</span>
                        @if (carrito.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow">
                                @carrito.Sum(x => x.Cantidad)
                            </span>
                        }
                    </button>
                </div>
            </div>

            <div class="modalidad-selector d-flex gap-1 bg-light p-1 rounded-3 border">
                <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "CONTADO" ? "btn-primary shadow-sm" : "btn-light text-muted")"
                        @onclick='() => CambiarModo("CONTADO")'>
                    <i class="bi bi-cash-stack me-1"></i> Venta Normal (Contado)
                </button>
                <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "CREDITO" ? "btn-warning text-dark shadow-sm" : "btn-light text-muted")"
                        @onclick='() => CambiarModo("CREDITO")'>
                    <i class="bi bi-credit-card-2-front-fill me-1"></i> A Crédito
                </button>
                <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "APARTADO" ? "btn-info text-white shadow-sm" : "btn-light text-muted")"
                        @onclick='() => CambiarModo("APARTADO")'>
                    <i class="bi bi-bookmark-star-fill me-1"></i> Apartado
                </button>
            </div>
        </div>

        <div class="categories-wrapper border-top border-bottom py-2 bg-white">
            <div class="categories-scroll d-flex gap-2 px-2">
                <button class="btn-category @(string.IsNullOrEmpty(categoriaSeleccionadaNombre) ? "cat-selected" : "cat-normal")"
                        style="background-color: #343a40; color: #ffffff;"
                        @onclick='() => SeleccionarCategoria("")'>
                    <i class="bi bi-grid-fill me-1"></i> TODOS
                </button>
                @foreach (var cat in categorias)
                {
                    bool isSelected = categoriaSeleccionadaNombre == cat.Nombre || categoriaSeleccionadaId == cat.Id;
                    string estilo = $"background-color: #{cat.Color}; color: {cat.Letra};";
                    string claseExtra = isSelected ? "cat-selected" : "cat-normal";

                    <button class="btn-category @claseExtra shadow-sm" style="@estilo"
                            @onclick="() => SeleccionarCategoria(cat.Nombre, cat.Id)">
                        @cat.Nombre
                    </button>
                }
            </div>
        </div>
    </div>

    @* --- GRID DE PRODUCTOS OPTIMIZADO --- *@
    <div class="products-container p-3">
        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted fw-semibold">Cargando catálogo...</p>
            </div>
        }
        else if (productosFiltrados.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                <h5>No se encontraron productos</h5>
                <p class="small">Prueba seleccionando otra categoría o limpiando la búsqueda.</p>
            </div>
        }
        else
        {
            <div class="row g-2 g-md-3">
                @foreach (var prod in productosFiltrados)
                {
                    var cantEnCarrito = carrito.Where(x => x.ProductoId == prod.Id).Sum(x => x.Cantidad);
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                        <div class="card product-card h-100 border-0 shadow-sm position-relative"
                             @onclick="() => AgregarProductoConBascula(prod)">

                            @if (cantEnCarrito > 0)
                            {
                                <span class="position-absolute top-0 end-0 badge rounded-pill bg-success m-2 p-2 shadow fs-6">
                                    @cantEnCarrito.ToString("0.##")
                                </span>
                            }

                            <div class="card-body p-2 d-flex flex-column text-center justify-content-between">
                                <div class="img-placeholder rounded-3 mb-2 p-2 bg-light d-flex align-items-center justify-content-center" style="height: 90px;">
                                    @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                                    {
                                        <img src="@prod.ImagenUrl" alt="@prod.Nombre" class="img-fluid rounded-3" style="max-height: 80px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="fs-1">📦</span>
                                    }
                                </div>
                                <div>
                                    <h6 class="card-title text-dark fw-bold mb-1 small text-truncate-2" title="@prod.Nombre">
                                        @prod.Nombre
                                    </h6>
                                </div>
                                <div class="price-tag fw-bold text-primary fs-5 mt-auto pt-1">
                                    $@prod.Precio.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* --- BARRA TOTAL INFERIOR --- *@
    <div class="bottom-bar bg-white border-top shadow-lg p-2 px-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="total-block">
                <span class="total-label text-muted small d-block">Total (@carrito.Sum(x => x.Cantidad) arts):</span>
                <span class="total-amount fs-3 fw-bold text-success">$@TotalCalculado.ToString("N2")</span>
            </div>
            @if (descuentoGlobal > 0)
            {
                <span class="badge bg-danger">Desc: -$@descuentoGlobal.ToString("N2")</span>
            }
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary d-md-none" @onclick="ToggleCarrito">
                <i class="bi bi-cart3"></i> Ver Lista
            </button>
            <button class="btn btn-success btn-lg px-4 fw-bold shadow"
                    disabled="@(carrito.Count == 0)"
                    @onclick="AbrirModalCobro">
                <i class="bi bi-check2-circle me-1"></i> Cobrar / Finalizar
            </button>
        </div>
    </div>

    @* --- DRAWER LATERAL DEL CARRITO --- *@
    @if (mostrarCarrito)
    {
        <div class="cart-overlay" @onclick="ToggleCarrito">
            <div class="cart-panel shadow-lg" @onclick:stopPropagation="true">
                <div class="cart-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="bi bi-cart-check me-2"></i>Detalle de Venta</h5>
                    <button class="btn-close btn-close-white" @onclick="ToggleCarrito"></button>
                </div>

                <div class="cart-body p-3 overflow-auto flex-grow-1" style="max-height: calc(100vh - 220px);">
                    @if (carrito.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                            El carrito está vacío.
                        </div>
                    }
                    @foreach (var item in carrito)
                    {
                        <div class="cart-item card mb-2 p-2 border shadow-sm">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="pe-2">
                                    <div class="fw-bold text-dark">@item.Nombre</div>
                                    <div class="text-muted small">
                                        $@item.Precio.ToString("N2") x @item.Cantidad.ToString("0.##")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Comentario))
                                    {
                                        <div class="small text-info fst-italic">
                                            <i class="bi bi-chat-dots me-1"></i>@item.Comentario
                                        </div>
                                    }
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-primary fs-6 mb-1">$@item.Subtotal.ToString("N2")</div>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" @onclick="() => ModificarCantidadCarrito(item, -1)">-</button>
                                        <button class="btn btn-outline-secondary" @onclick="() => ModificarCantidadCarrito(item, 1)">+</button>
                                        <button class="btn btn-outline-danger" @onclick="() => EliminarDelCarrito(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="cart-footer p-3 bg-light border-top">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Subtotal:</span>
                        <span>$@SubtotalCalculado.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">Descuento:</span>
                        <div class="input-group input-group-sm" style="max-width: 120px;">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control text-end" min="0" step="1" @bind="descuentoGlobal" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-between fs-4 fw-bold text-success border-top pt-2 mb-3">
                        <span>Total:</span>
                        <span>$@TotalCalculado.ToString("N2")</span>
                    </div>
                    <button class="btn btn-success w-100 py-2 fw-bold shadow"
                            disabled="@(carrito.Count == 0)"
                            @onclick="AbrirModalCobro">
                        Proceder al Cobro
                    </button>
                </div>
            </div>
        </div>
    }

    @* --- MODAL BUSCAR CLIENTE --- *@
    @if (mostrarModalClientes)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="bi bi-people-fill me-2"></i>Seleccionar Cliente</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalClientes = false"></button>
                    </div>

                    <div class="modal-body p-3">
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Buscar por nombre o teléfono..."
                                   @bind="busquedaCliente" @bind:event="oninput" @onkeyup="FiltrarClientes" />
                        </div>

                        @if (modoVenta == "CONTADO")
                        {
                            <div class="mb-3">
                                <button class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick="SeleccionarPublicoGeneral">
                                    <i class="bi bi-person-badge me-1"></i> PÚBLICO EN GENERAL (Venta Rápida)
                                </button>
                            </div>
                        }

                        <div class="list-group overflow-auto" style="max-height: 50vh;">
                            @foreach (var cl in listaClientesFiltrados)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"
                                        @onclick="() => SeleccionarCliente(cl)">
                                    <div>
                                        <h6 class="mb-1 fw-bold text-dark">@cl.Nombre</h6>
                                        <div class="small text-muted">
                                            <i class="bi bi-telephone me-1"></i>@(string.IsNullOrEmpty(cl.Telefono) ? "Sin tel" : cl.Telefono) |
                                            <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(cl.Direccion) ? "Sin dirección" : cl.Direccion)
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-warning text-dark d-block mb-1">Adeudo: $@cl.Adeudo.ToString("N2")</span>
                                        <span class="badge bg-info text-white">Límite: $@cl.Limite.ToString("N2")</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- MODAL DE COBRO / FINALIZACIÓN --- *@
    @if (mostrarModalCobro)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-md">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header @HeaderColorCobro text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="@IconoModo me-2"></i> Finalizar Venta: @TituloModo
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalCobro = false"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="bg-light p-3 rounded-3 mb-3 border">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Cliente:</span>
                                <span class="fw-bold">@(clienteSeleccionado != null ? clienteSeleccionado.Nombre : "Público en General")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Total a Pagar:</span>
                                <span class="fw-bold fs-4 text-success">$@TotalCalculado.ToString("N2")</span>
                            </div>
                        </div>

                        @if (modoVenta == "CONTADO")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Método de Pago Principal:</label>
                                <select class="form-select form-select-lg fw-semibold" @bind="metodoPagoSeleccionado">
                                    <option value="Efectivo">💵 Efectivo</option>
                                    <option value="Tarjeta">💳 Tarjeta (Crédito / Débito)</option>
                                    <option value="Transferencia">📲 Transferencia</option>
                                    <option value="Cheque">📜 Cheque</option>
                                </select>
                            </div>

                            @if (metodoPagoSeleccionado == "Efectivo")
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Monto Recibido:</label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control fs-3 fw-bold text-success"
                                               step="any" @bind="montoRecibido" @bind:event="oninput" />
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => montoRecibido = TotalCalculado">Exacto</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => montoRecibido = 100">$100</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => montoRecibido = 200">$200</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => montoRecibido = 500">$500</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => montoRecibido = 1000">$1000</button>
                                    </div>

                                    <div class="mt-3 p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                                        <span class="fw-bold fs-5">Cambio:</span>
                                        <span class="fw-bold fs-4 @(CambioCalculado >= 0 ? "text-primary" : "text-danger")">
                                            $@CambioCalculado.ToString("N2")
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                        else if (modoVenta == "CREDITO")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Enganche / Abono Inicial (Opcional):</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control fs-3 fw-bold" step="any" @bind="abonoInicial" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Método de Pago del Abono:</label>
                                <select class="form-select" @bind="metodoPagoSeleccionado">
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Tarjeta">Tarjeta</option>
                                    <option value="Transferencia">Transferencia</option>
                                </select>
                            </div>
                            <div class="p-3 bg-light rounded border">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Saldo que se cargará al crédito:</span>
                                    <span class="fw-bold text-danger">$@((TotalCalculado - abonoInicial).ToString("N2"))</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Nuevo Adeudo Total:</span>
                                    <span class="fw-bold">$@(((clienteSeleccionado?.Adeudo ?? 0) + (TotalCalculado - abonoInicial)).ToString("N2"))</span>
                                </div>
                            </div>
                        }
                        else if (modoVenta == "APARTADO")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Monto de Anticipo / Abono Inicial:</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control fs-3 fw-bold text-success" step="any" @bind="abonoInicial" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Método de Pago del Anticipo:</label>
                                <select class="form-select" @bind="metodoPagoSeleccionado">
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Tarjeta">Tarjeta</option>
                                    <option value="Transferencia">Transferencia</option>
                                </select>
                            </div>
                            <div class="p-3 bg-light rounded border d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Restante por Liquidar:</span>
                                <span class="fw-bold fs-4 text-danger">$@((TotalCalculado - abonoInicial).ToString("N2"))</span>
                            </div>
                        }
                    </div>

                    <div class="modal-footer bg-light p-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => mostrarModalCobro = false">Cancelar</button>
                        <button type="button" class="btn btn-success px-4 py-2 fw-bold shadow"
                                disabled="@guardandoVenta"
                                @onclick="ProcesarCobroFinal">
                            @if (guardandoVenta)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                                <span>Confirmar e Imprimir</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pos-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background-color: #f8f9fa;
        padding-bottom: 90px;
    }

    .sticky-header-group {
        position: sticky;
        top: 0;
        z-index: 1020;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .header-bar {
        padding: 10px 16px;
    }

    .categories-wrapper {
        overflow: hidden;
    }

    .categories-scroll {
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: thin;
        padding-bottom: 4px;
    }

        .categories-scroll::-webkit-scrollbar {
            height: 5px;
        }

        .categories-scroll::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 4px;
        }

    .btn-category {
        border: none;
        border-radius: 20px;
        padding: 8px 18px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        flex-shrink: 0;
    }

        .btn-category:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

    .cat-selected {
        outline: 3px solid #000000;
        transform: scale(1.05);
    }

    .product-card {
        cursor: pointer;
        border-radius: 12px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        background: #ffffff;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.12) !important;
        }

        .product-card:active {
            transform: scale(0.97);
        }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.4em;
    }

    .bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1030;
    }

    .cart-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 1050;
        display: flex;
        justify-content: flex-end;
    }

    .cart-panel {
        width: 100%;
        max-width: 420px;
        height: 100%;
        background: #ffffff;
        display: flex;
        flex-direction: column;
    }
</style>

@code {
    [Parameter]
    public string? ModoInicial { get; set; }

    private string modoVenta = "CONTADO";
    private bool cargando = true;
    private bool guardandoVenta = false;
    private bool mostrarCarrito = false;
    private bool mostrarModalClientes = false;
    private bool mostrarModalCobro = false;

    private int categoriaSeleccionadaId = 0;
    private string categoriaSeleccionadaNombre = "";
    private string textoBusqueda = "";
    private string busquedaCliente = "";

    private List<CategoriaVenta> categorias = new();
    private List<ProductoVenta> todosProductos = new();
    private List<ProductoVenta> productosFiltrados = new();
    private List<ItemCarritoVenta> carrito = new();
    private List<ClienteVentaDto> listaClientes = new();
    private List<ClienteVentaDto> listaClientesFiltrados = new();

    private ClienteVentaDto? clienteSeleccionado;
    private double descuentoGlobal = 0;
    private string metodoPagoSeleccionado = "Efectivo";
    private double montoRecibido = 0;
    private double abonoInicial = 0;

    private double SubtotalCalculado => carrito.Sum(x => x.Subtotal);
    private double TotalCalculado => Math.Max(0, SubtotalCalculado - descuentoGlobal);
    private double CambioCalculado => Math.Max(0, montoRecibido - TotalCalculado);
    bool Bascula = false;
    private string TituloModo => modoVenta switch
    {
        "CREDITO" => "Venta a Crédito",
        "APARTADO" => "Venta en Apartado",
        _ => "Venta Normal (Contado)"
    };

    private string BadgeColorModo => modoVenta switch
    {
        "CREDITO" => "bg-warning text-dark",
        "APARTADO" => "bg-info text-white",
        _ => "bg-primary text-white"
    };

    private string IconoModo => modoVenta switch
    {
        "CREDITO" => "bi bi-credit-card-2-front-fill",
        "APARTADO" => "bi bi-bookmark-star-fill",
        _ => "bi bi-cash-stack"
    };

    private string HeaderColorCobro => modoVenta switch
    {
        "CREDITO" => "bg-warning text-dark",
        "APARTADO" => "bg-info",
        _ => "bg-success"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ModoInicial))
        {
            modoVenta = ModoInicial.ToUpper() switch
            {
                "CREDITO" => "CREDITO",
                "APARTADO" => "APARTADO",
                _ => "CONTADO"
            };
        }
        var configNegocio = await _cotizacionService.ObtenerConfiguracion();
        Bascula = configNegocio.Bascula;
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        cargando = true;
        try
        {
            categorias = await VentaService.ObtenerCategoriasAsync();
            todosProductos = await VentaService.ObtenerProductosAsync();
            productosFiltrados = todosProductos;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar catálogo: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ProcesarBusquedaOEscaneo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda)) return;

            string input = textoBusqueda.Trim();

            if (input.StartsWith("PRE:", StringComparison.OrdinalIgnoreCase))
            {
                await ProcesarPreventaQR(input);
                textoBusqueda = "";
                return;
            }

            var productoEncontrado = todosProductos.FirstOrDefault(p => p.Id.Equals(input, StringComparison.OrdinalIgnoreCase));
            if (productoEncontrado != null)
            {
                await AgregarProductoConBascula(productoEncontrado);
                textoBusqueda = "";
            }
            else
            {
                FiltrarProductos();
            }
        }
        else
        {
            FiltrarProductos();
        }
    }

    private async Task ProcesarPreventaQR(string cadenaQR)
    {
        try
        {
            string datos = cadenaQR.Substring(4);
            string[] items = datos.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var item in items)
            {
                string[] partes = item.Split(':');
                if (partes.Length == 2)
                {
                    string idProd = partes[0];
                    if (double.TryParse(partes[1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double cant))
                    {
                        var prod = await VentaService.BuscarProductoPorIdAsync(idProd);
                        if (prod != null)
                        {
                            AgregarDirectoAlCarrito(prod, cant);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al procesar QR de preventa: {ex.Message}");
        }
    }

    private async Task<double> ObtenerPesoBasculaLocalAsync()
    {
        if (!Bascula)
        { return 1; } // Si la bascula está deshabilitada, retornamos 1 como cantidad por defecto
        try
        {
            var res = await Http.GetStringAsync("http://localhost:8080/peso/");
            if (!string.IsNullOrEmpty(res) && res != "ERROR")
            {
                if (double.TryParse(res, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double peso))
                {
                    return peso > 0 ? peso : 1;
                }
            }
        }
        catch { }
        return 1;
    }

    private async Task AgregarProductoConBascula(ProductoVenta prod)
    {
        double pesoBasc = await ObtenerPesoBasculaLocalAsync();
        AgregarDirectoAlCarrito(prod, pesoBasc);
    }

    private void AgregarDirectoAlCarrito(ProductoVenta prod, double cantidad)
    {
        var existente = carrito.FirstOrDefault(x => x.ProductoId == prod.Id && string.IsNullOrEmpty(x.Comentario));
        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new ItemCarritoVenta
            {
                ProductoId = prod.Id,
                Nombre = prod.Nombre,
                Precio = prod.Precio,
                Cantidad = cantidad,
                Costo = prod.CostoTotal,
                Categoria = prod.Categoria,
                Existencia = prod.Existencia,
                Iva = prod.Iva
            });
        }
    }

    private async Task CambiarModo(string nuevoModo)
    {
        modoVenta = nuevoModo;

        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await AbrirModalCliente();
        }
        StateHasChanged();
    }

    private void SeleccionarCategoria(string nombreCat, int idCat = 0)
    {
        categoriaSeleccionadaNombre = nombreCat;
        categoriaSeleccionadaId = idCat;
        FiltrarProductos();
    }

    private void FiltrarProductos()
    {
        var lista = todosProductos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(categoriaSeleccionadaNombre))
        {
            lista = lista.Where(x =>
                x.Categoria.Equals(categoriaSeleccionadaNombre, StringComparison.OrdinalIgnoreCase) ||
                (categoriaSeleccionadaId > 0 && x.IdCategoria == categoriaSeleccionadaId));
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            lista = lista.Where(x => x.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                     x.Id.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }

        productosFiltrados = lista.ToList();
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        FiltrarProductos();
    }

    private void ModificarCantidadCarrito(ItemCarritoVenta item, double delta)
    {
        item.Cantidad += delta;
        if (item.Cantidad <= 0)
        {
            carrito.Remove(item);
        }
    }

    private void EliminarDelCarrito(ItemCarritoVenta item)
    {
        carrito.Remove(item);
    }

    private void ToggleCarrito()
    {
        mostrarCarrito = !mostrarCarrito;
    }

    private async Task AbrirModalCliente()
    {
        listaClientes = await VentaService.BuscarClientesAsync();
        listaClientesFiltrados = listaClientes;
        busquedaCliente = "";
        mostrarModalClientes = true;
    }

    private void FiltrarClientes()
    {
        if (string.IsNullOrWhiteSpace(busquedaCliente))
        {
            listaClientesFiltrados = listaClientes;
        }
        else
        {
            listaClientesFiltrados = listaClientes.Where(c =>
                c.Nombre.Contains(busquedaCliente, StringComparison.OrdinalIgnoreCase) ||
                c.Telefono.Contains(busquedaCliente, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void SeleccionarCliente(ClienteVentaDto cl)
    {
        clienteSeleccionado = cl;
        mostrarModalClientes = false;
    }

    private void SeleccionarPublicoGeneral()
    {
        clienteSeleccionado = null;
        mostrarModalClientes = false;
    }

    private async Task AbrirModalCobro()
    {
        if (carrito.Count == 0) return;

        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await JS.InvokeVoidAsync("alert", $"Para {TituloModo} es obligatorio seleccionar un cliente.");
            await AbrirModalCliente();
            return;
        }

        montoRecibido = TotalCalculado;
        abonoInicial = modoVenta == "APARTADO" ? Math.Round(TotalCalculado * 0.20, 2) : 0;
        mostrarCarrito = false;
        mostrarModalCobro = true;
    }

    private async Task ProcesarCobroFinal()
    {
        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await JS.InvokeVoidAsync("alert", "Debes seleccionar un cliente.");
            return;
        }

        if (modoVenta == "CONTADO" && metodoPagoSeleccionado == "Efectivo" && montoRecibido < TotalCalculado)
        {
            await JS.InvokeVoidAsync("alert", "El monto recibido es menor al total a pagar.");
            return;
        }

        guardandoVenta = true;
        try
        {
            var req = new VentaGuardarRequest
            {
                TipoVenta = modoVenta,
                Folio = "", // Dejamos vacío: se asigna e incrementa en la transacción de Access
                IdCliente = clienteSeleccionado?.Id ?? "0",
                NombreCliente = clienteSeleccionado?.Nombre ?? "PUBLICO EN GENERAL",
                DireccionCliente = clienteSeleccionado?.Direccion ?? "",
                TelefonoCliente = clienteSeleccionado?.Telefono ?? "",
                Subtotal = SubtotalCalculado,
                Descuento = descuentoGlobal,
                Total = TotalCalculado,
                MetodoPago = metodoPagoSeleccionado,
                MontoRecibido = montoRecibido,
                Cambio = CambioCalculado,
                AbonoInicial = abonoInicial,
                Restante = TotalCalculado - abonoInicial,
                IdUsuario= "1",
                Usuario=  "cajero 1",
                Items = new List<ItemCarritoVenta>(carrito)
            };

            var resultado = await VentaService.GuardarVentaAsync(req);
            if (resultado.Exito)
            {
                req.Folio = resultado.FolioFinal;

                try
                {
                    await ImpresionService.ImprimirTicketVentaAsync(req);
                }
                catch (Exception exPrint)
                {
                    Console.WriteLine($"Error al imprimir ticket: {exPrint.Message}");
                }

                await JS.InvokeVoidAsync("alert", $"¡{TituloModo} registrada exitosamente!\nFolio: {resultado.FolioFinal}");

                carrito.Clear();
                descuentoGlobal = 0;
                if (modoVenta == "CONTADO") clienteSeleccionado = null;
                mostrarModalCobro = false;
                todosProductos = await VentaService.ObtenerProductosAsync();
                FiltrarProductos();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error: {resultado.Mensaje}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ocurrió un error: {ex.Message}");
        }
        finally
        {
            guardandoVenta = false;
        }
    }
}