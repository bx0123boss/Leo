@page "/ventas"
@page "/ventas/{ModoInicial}"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject CotizacionService _cotizacionService
@inject VentaService VentaService
@inject ImpresionPosService ImpresionService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="pos-layout">
    @* ================= SECCIÓN IZQUIERDA: CATÁLOGO Y PRODUCTOS ================= *@
    <div class="pos-catalog">
        @* Barra Superior de Control y Búsqueda *@
        <div class="pos-header-bar p-2 px-3 bg-white border-bottom d-flex align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @BadgeColorModo px-3 py-2 fs-6 shadow-sm">
                    <i class="@IconoModo me-1"></i> @TituloModo
                </span>

                @* ⭐ BOTÓN NUEVA VENTA EN PESTAÑA APARTE *@
                <button class="btn btn-sm btn-outline-success fw-bold bg-white shadow-sm rounded-pill px-3"
                        @onclick="AbrirNuevaVentaEnPestana"
                        title="Guardar esta venta en stand-by y abrir una nueva en otra pestaña">
                    <i class="bi bi-plus-square-fill text-success me-1"></i>Venta</button>

                <button class="btn btn-sm btn-outline-primary fw-bold bg-white shadow-sm rounded-pill px-3"
                        @onclick="AbrirModalCliente">
                    <i class="bi bi-person-fill text-primary me-1"></i>
                    @(clienteSeleccionado != null ? clienteSeleccionado.Nombre : (modoVenta == "CONTADO" ? "Público en General" : "Seleccionar Cliente *"))
                </button>

                @* ⭐ INDICADOR DE VENTAS EN STAND-BY *@
                @if (ventasStandbyCount > 0)
                {
                    <button class="btn btn-sm btn-warning fw-bold shadow-sm rounded-pill px-3"
                            @onclick="AbrirModalStandby"
                            title="Ventas en espera">
                        <i class="bi bi-pause-circle-fill me-1"></i>
                        @ventasStandbyCount en espera
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end" style="max-width: 420px;">
                <div class="input-group input-group-sm">
                    <button type="button" class="input-group-text bg-light border-end-0"
                            @onclick="FiltrarDesdeLupa"
                            title="Buscar / Filtrar"
                            style="cursor: pointer;">
                        <i class="bi bi-search"></i>
                    </button>

                    @if (AbrirTeclado)
                    {
                        <input type="text" class="form-control bg-light border-start-0 fw-bold pos-search-input"
                               placeholder="Escanear o buscar..."
                               data-kioskboard-type="all"
                               data-kioskboard-specialcharacters="true"
                               @bind="textoBusqueda" @bind:event="oninput" @bind:after="OnBusquedaChanged"
                               @onkeydown="ProcesarBusquedaOEscaneo" autofocus />
                    }
                    else
                    {
                        <input type="text" class="form-control bg-light border-start-0 fw-bold pos-search-input"
                               placeholder="Escanear o buscar..."
                               @bind="textoBusqueda" @bind:event="oninput" @bind:after="OnBusquedaChanged"
                               @onkeydown="ProcesarBusquedaOEscaneo" autofocus />
                    }

                    @if (!string.IsNullOrEmpty(textoBusqueda))
                    {
                        <button class="btn btn-outline-secondary border" @onclick="LimpiarBusqueda" title="Limpiar">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                @* BOTÓN SOLO VISIBLE EN MÓVIL/TABLET PARA ABRIR CARRITO *@
                <button class="btn btn-primary btn-sm position-relative shadow-sm rounded-pill px-3 d-lg-none flex-shrink-0"
                        @onclick="ToggleCarrito">
                    <i class="bi bi-cart3 fs-6 me-1"></i>
                    <span class="d-none d-sm-inline">@TotalCalculado.ToString("N2")</span>
                    @if (carrito.Count > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow">
                            @carrito.Sum(x => x.Cantidad).ToString("0.##")
                        </span>
                    }
                </button>
            </div>
        </div>

        @* Barra de Selector de Modalidad *@
        <div class="pos-mode-bar px-3 py-2 bg-light border-bottom d-flex gap-2">
            <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "CONTADO" ? "btn-primary shadow-sm" : "btn-outline-secondary bg-white")"
                    @onclick='() => CambiarModo("CONTADO")'>
                <i class="bi bi-cash-stack me-1"></i> Contado
            </button>
            <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "CREDITO" ? "btn-warning text-dark shadow-sm" : "btn-outline-secondary bg-white")"
                    @onclick='() => CambiarModo("CREDITO")'>
                <i class="bi bi-credit-card-2-front-fill me-1"></i> Crédito
            </button>
            <button class="btn btn-sm flex-fill fw-bold @(modoVenta == "APARTADO" ? "btn-info text-white shadow-sm" : "btn-outline-secondary bg-white")"
                    @onclick='() => CambiarModo("APARTADO")'>
                <i class="bi bi-bookmark-star-fill me-1"></i> Apartado
            </button>
        </div>

        @* Categorías *@
        <div class="pos-categories-bar bg-white border-bottom px-2 py-2 position-relative d-flex align-items-center @(categoriasCompactas ? "compact" : "")">
            <button type="button" class="btn btn-scroll-arrow me-2 flex-shrink-0" @onclick='() => ScrollCategorias(-300)' title="Desplazar izquierda">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="categories-two-rows overflow-auto flex-grow-1 no-scrollbar py-1"
                 @ref="categoriesContainer"
                 @onwheel="OnCategoriasWheel">

                <button type="button" class="btn-category @(string.IsNullOrEmpty(categoriaSeleccionadaNombre) ? "cat-selected" : "cat-normal")"
                        style="background-color: #343a40; color: #ffffff;"
                        @onclick='() => SeleccionarCategoria("")'>
                    <i class="bi bi-grid-fill me-1"></i> TODOS
                </button>

                @foreach (var cat in categorias)
                {
                    bool isSelected = categoriaSeleccionadaNombre == cat.Nombre || categoriaSeleccionadaId == cat.Id;
                    string estilo = $"background-color: #{cat.Color}; color: {cat.Letra};";
                    string claseExtra = isSelected ? "cat-selected" : "cat-normal";

                    <button type="button" class="btn-category @claseExtra shadow-sm" style="@estilo"
                            @onclick="() => SeleccionarCategoria(cat.Nombre, cat.Id)">
                        @cat.Nombre
                    </button>
                }
            </div>

            <button type="button" class="btn btn-scroll-arrow ms-2 flex-shrink-0" @onclick='() => ScrollCategorias(300)' title="Desplazar derecha">
                <i class="bi bi-chevron-right"></i>
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary ms-2 flex-shrink-0"
                    @onclick="ToggleCategoriasCompactas"
                    title="@(categoriasCompactas ? "Expandir categorías" : "Reducir categorías")">
                <i class="bi @(categoriasCompactas ? "bi-arrows-fullscreen" : "bi-arrows-angle-contract")"></i>
            </button>
        </div>

        @* Grilla de Productos *@
        <div class="pos-products-grid p-3">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted fw-semibold">Cargando catálogo...</p>
                </div>
            }
            else if (productosFiltrados.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                    <h5>No se encontraron productos</h5>
                </div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var prod in productosFiltrados)
                    {
                        var cantEnCarrito = carrito.Where(x => x.ProductoId == prod.Id).Sum(x => x.Cantidad);
                        var animando = _productoAnimandoId == prod.Id;

                        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                            <div class="card product-card h-100 border-0 shadow-sm position-relative p-2 @(animando ? "animate-add" : "")"
                                 @onclick="() => AgregarProductoConBascula(prod)">

                                @if (cantEnCarrito > 0)
                                {
                                    <span class="position-absolute top-0 end-0 badge rounded-pill bg-success m-2 p-1 shadow fs-7">
                                        @cantEnCarrito.ToString("0.##")
                                    </span>
                                }

                                <div class="card-body p-1 d-flex flex-column text-center justify-content-between">
                                    <div class="img-placeholder rounded-3 mb-2 p-1 bg-light d-flex align-items-center justify-content-center" style="height: 75px;">
                                        @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                                        {
                                            <img src="/@prod.ImagenUrl" alt="@prod.Nombre" class="img-fluid rounded-3" style="max-height: 70px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="fs-2">📦</span>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="card-title text-dark fw-bold mb-1 extra-small text-truncate-2" title="@prod.Nombre">
                                            @prod.Nombre
                                        </h6>
                                    </div>
                                    <div class="price-tag fw-bold text-primary fs-6 mt-auto pt-1">
                                        $@prod.Precio.ToString("N2")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        @if (AbrirTeclado)
        {
            <OnScreenKeyboard ClassName="pos-search-input" />
        }
    </div>

    @* ================= SECCIÓN DERECHA: CHECKOUT / CARRITO VISIBLE ================= *@
    <div class="pos-checkout bg-white border-start d-flex flex-column @(mostrarCarrito ? "mobile-show" : "")">
        <div class="checkout-header p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
            <h6 class="m-0 fw-bold text-dark">
                <i class="bi bi-cart3 me-2"></i>Detalle de Venta
            </h6>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-pill fs-6">@carrito.Sum(x => x.Cantidad).ToString("0.##") arts</span>
                <button class="btn btn-sm btn-outline-danger d-none d-lg-inline-flex"
                        @onclick="VaciarCarrito"
                        disabled="@(carrito.Count == 0)"
                        title="Vaciar carrito (Ctrl+Supr)">
                    <i class="bi bi-trash3"></i>
                </button>
                <button class="btn-close d-lg-none" @onclick="ToggleCarrito"></button>
            </div>
        </div>

        @* Items del Carrito *@
        <div class="checkout-items flex-grow-1 p-3 overflow-auto">
            @if (carrito.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                    <span>El carrito está vacío.</span>
                </div>
            }
            @foreach (var item in carrito)
            {
                <div class="cart-item card mb-2 p-2 border shadow-sm">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="pe-2">
                            <div class="fw-bold text-dark small">@item.Nombre</div>
                            <input type="number"
                                   class="form-control form-control-sm text-center fw-bold p-0"
                                   style="width: 70px; height: 24px; font-size: 0.85rem;"
                                   min="0.0"
                                   step="1"
                                   @bind="item.Cantidad"
                                   @bind:after="() => OnCantidadChanged(item)" />
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-primary fs-6 mb-1">$@item.Subtotal.ToString("N2")</div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary btn-sm px-2 py-0" @onclick="() => ModificarCantidadCarrito(item, -1)">-</button>
                                <button class="btn btn-outline-secondary btn-sm px-2 py-0" @onclick="() => ModificarCantidadCarrito(item, 1)">+</button>
                                <button class="btn btn-outline-danger btn-sm px-2 py-0" @onclick="() => EliminarDelCarrito(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Totales y Botón de Cobro *@
        <div class="checkout-footer p-3 border-top bg-light">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Subtotal:</span>
                <span>$@SubtotalCalculado.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold">Descuento ($):</span>
                <input type="number" class="form-control form-control-sm text-end" style="max-width: 100px;"
                       min="0" step="1" @bind="descuentoGlobal" @bind:after="OnDescuentoChanged" />
            </div>
            <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-3">
                <span class="fw-bold fs-5 text-dark">Total:</span>
                <span class="fw-bold fs-3 text-success">$@TotalCalculado.ToString("N2")</span>
            </div>

            <button class="btn btn-success w-100 py-3 fw-bold fs-5 shadow"
                    disabled="@(carrito.Count == 0 || guardandoVenta)"
                    @onclick="AbrirModalCobro"
                    style="@(guardandoVenta ? "pointer-events:none;opacity:.6;" : "")"
                    title="Cobrar (F2)">
                <i class="bi bi-check2-circle me-1"></i> Cobrar / Finalizar
            </button>
        </div>
    </div>

    @if (mostrarCarrito)
    {
        <div class="cart-backdrop d-lg-none" @onclick="ToggleCarrito"></div>
    }

    @* --- MODAL BUSCAR CLIENTE --- *@
    @if (mostrarModalClientes)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="bi bi-people-fill me-2"></i>Seleccionar Cliente</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalClientes = false"></button>
                    </div>

                    <div class="modal-body p-3">
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Buscar por nombre o teléfono..."
                                   @bind="busquedaCliente" @bind:event="oninput" @bind:after="FiltrarClientes" />
                        </div>

                        @if (modoVenta == "CONTADO")
                        {
                            <div class="mb-3">
                                <button class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick="SeleccionarPublicoGeneral">
                                    <i class="bi bi-person-badge me-1"></i> PÚBLICO EN GENERAL (Venta Rápida)
                                </button>
                            </div>
                        }

                        <div class="list-group overflow-auto" style="max-height: 50vh;">
                            @foreach (var cl in listaClientesFiltrados)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"
                                        @onclick="() => SeleccionarCliente(cl)">
                                    <div>
                                        <h6 class="mb-1 fw-bold text-dark">@cl.Nombre</h6>
                                        <div class="small text-muted">
                                            <i class="bi bi-telephone me-1"></i>@(string.IsNullOrEmpty(cl.Telefono) ? "Sin tel" : cl.Telefono) |
                                            <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(cl.Direccion) ? "Sin dirección" : cl.Direccion)
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-warning text-dark d-block mb-1">Adeudo: $@cl.Adeudo.ToString("N2")</span>
                                        <span class="badge bg-info text-white">Límite: $@cl.Limite.ToString("N2")</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ⭐ MODAL VENTAS EN STAND-BY *@
    @if (mostrarModalStandby)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title fw-bold"><i class="bi bi-pause-circle-fill me-2"></i>Ventas en Espera (Stand-by)</h5>
                        <button type="button" class="btn-close" @onclick="() => mostrarModalStandby = false"></button>
                    </div>
                    <div class="modal-body p-3">
                        @if (ventasStandby.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No hay ventas en espera.
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var v in ventasStandby)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">
                                                @v.Modo · @v.Items.Count art. · @v.Fecha.ToString("HH:mm:ss")
                                            </div>
                                            <div class="small text-muted">
                                                Total: $@v.Total.ToString("N2")
                                                @if (!string.IsNullOrEmpty(v.NombreCliente))
                                                {
                                                    <span> · @v.NombreCliente</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-success" @onclick="() => RecuperarStandby(v)">
                                                <i class="bi bi-arrow-return-left me-1"></i>Recuperar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarStandby(v.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- MODAL DE COBRO / FINALIZACIÓN --- *@
    @if (mostrarModalCobro)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header @HeaderColorCobro text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="@IconoModo me-2"></i> Finalizar Venta: @TituloModo
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalCobro = false"></button>
                    </div>

                    <div class="modal-body p-3">
                        <div class="row g-3">
                            @* ================= COLUMNA IZQUIERDA: DETALLE Y MÉTODOS DE PAGO ================= *@
                            <div class="col-12 col-lg-7">
                                <div class="bg-light p-3 rounded-3 mb-3 border">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Cliente:</span>
                                        <span class="fw-bold">@(clienteSeleccionado != null ? clienteSeleccionado.Nombre : "Público en General")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Total a Pagar:</span>
                                        <span class="fw-bold fs-3 text-success">$@TotalCalculado.ToString("N2")</span>
                                    </div>
                                </div>

                                @if (modoVenta == "CONTADO")
                                {
                                    <div class="form-check form-switch mb-3 p-2 bg-light rounded border ps-5">
                                        <input class="form-check-input" type="checkbox" role="switch" id="chkMixto"
                                               checked="@esPagoMixto" @onchange="TogglePagoMixto" disabled="@guardandoVenta">
                                        <label class="form-check-label fw-bold text-dark" for="chkMixto">
                                            <i class="bi bi-wallet2 me-1"></i> Habilitar Pago Mixto / Múltiples Métodos
                                        </label>
                                    </div>

                                    @if (!esPagoMixto)
                                    {
                                        @* PAGO SIMPLE *@
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Método de Pago Principal:</label>
                                            <select class="form-select form-select-lg fw-semibold" @bind="metodoPagoSeleccionado" disabled="@guardandoVenta">
                                                <option value="Efectivo">💵 Efectivo</option>
                                                <option value="Tarjeta">💳 Tarjeta (Crédito / Débito)</option>
                                                <option value="Transferencia">📲 Transferencia</option>
                                                <option value="Cheque">📜 Cheque</option>
                                            </select>
                                        </div>

                                        @if (metodoPagoSeleccionado == "Efectivo")
                                        {
                                            <div class="mb-2">
                                                <label class="form-label fw-bold">Monto Recibido:</label>
                                                <div class="input-group input-group-lg">
                                                    <span class="input-group-text">$</span>
                                                    <input type="text" class="form-control fs-3 fw-bold text-success" readonly
                                                           value="@textoCapturaNumpad" />
                                                    <button class="btn btn-outline-danger" type="button" @onclick="LimpiarNumpad" title="Borrar entrada" disabled="@guardandoVenta">
                                                        <i class="bi bi-backspace-fill"></i>
                                                    </button>
                                                </div>
                                                <div class="mt-3 p-3 rounded border d-flex justify-content-between align-items-center
                                                                                    @(MontoRecibidoNumpad >= TotalCalculado ? "bg-success-subtle border-success" : "bg-warning-subtle border-warning")">
                                                    <span class="fw-bold fs-5">Cambio:</span>
                                                    <span class="fw-bold fs-3 @(MontoRecibidoNumpad >= TotalCalculado ? "text-success" : "text-danger")">
                                                        $@CambioCalculadoNumpad.ToString("N2")
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @* PAGO MIXTO *@
                                        <div class="border rounded p-3 bg-white mb-2 shadow-sm">
                                            <div class="row g-2 mb-2">
                                                <div class="col-6">
                                                    <label class="form-label extra-small fw-bold m-0">MÉTODO</label>
                                                    <select class="form-select form-select-sm fw-semibold" @bind="metodoPagoAgregando" disabled="@guardandoVenta">
                                                        <option value="Efectivo">💵 Efectivo</option>
                                                        <option value="Tarjeta">💳 Tarjeta</option>
                                                        <option value="Transferencia">📲 Transferencia</option>
                                                        <option value="Cheque">📜 Cheque</option>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label extra-small fw-bold m-0">MONTO A AGREGAR</label>
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text">$</span>
                                                        <input type="text" class="form-control fw-bold bg-light" readonly value="@textoCapturaNumpad" />
                                                        <button class="btn btn-primary fw-bold px-3" type="button" @onclick="AgregarPagoMixto" disabled="@guardandoVenta">
                                                            <i class="bi bi-plus-lg me-1"></i> Agregar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            @* TABLA DE PAGOS AGREGADOS *@
                                            <div class="table-responsive my-2" style="max-height: 140px;">
                                                <table class="table table-sm table-bordered align-middle m-0">
                                                    <thead class="table-light extra-small text-uppercase">
                                                        <tr>
                                                            <th>Método</th>
                                                            <th class="text-end">Monto</th>
                                                            <th class="text-center" style="width: 40px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="small">
                                                        @if (pagosRealizados.Count == 0)
                                                        {
                                                            <tr>
                                                                <td colspan="3" class="text-center text-muted py-2">Sin pagos agregados</td>
                                                            </tr>
                                                        }
                                                        @foreach (var p in pagosRealizados)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold">@p.Key</td>
                                                                <td class="text-end fw-bold text-primary">$@p.Value.ToString("N2")</td>
