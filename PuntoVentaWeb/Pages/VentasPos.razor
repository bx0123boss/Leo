                            </div>

                            @* ================= COLUMNA DERECHA: BOTONERA TÁCTIL Y NUMPAD ================= *@
                            <div class="col-12 col-lg-5 border-start ps-lg-3">
                                <h6 class="fw-bold mb-2 text-muted"><i class="bi bi-calculator me-1"></i> Teclado Táctil</h6>

                                @* Botonera Rápida de Billetes *@
                                <div class="row g-2 mb-3">
                                    <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick='() => PresionarBillete(50)' disabled="@guardandoVenta">$50</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick='() => PresionarBillete(100)' disabled="@guardandoVenta">$100</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick='() => PresionarBillete(200)' disabled="@guardandoVenta">$200</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick='() => PresionarBillete(500)' disabled="@guardandoVenta">$500</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" @onclick='() => PresionarBillete(1000)' disabled="@guardandoVenta">$1000</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-success-subtle text-success border-success w-100 py-2 fw-bold" @onclick="PresionarPagoExacto" disabled="@guardandoVenta">EXACTO</button></div>
                                </div>

                                @* Teclado Numérico (Numpad) *@
                                <div class="row g-2 text-center">
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("7")' disabled="@guardandoVenta">7</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("8")' disabled="@guardandoVenta">8</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("9")' disabled="@guardandoVenta">9</button></div>

                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("4")' disabled="@guardandoVenta">4</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("5")' disabled="@guardandoVenta">5</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("6")' disabled="@guardandoVenta">6</button></div>

                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("1")' disabled="@guardandoVenta">1</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("2")' disabled="@guardandoVenta">2</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("3")' disabled="@guardandoVenta">3</button></div>

                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad("0")' disabled="@guardandoVenta">0</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-light border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick='() => PresionarNumpad(".")' disabled="@guardandoVenta">.</button></div>
                                    <div class="col-4"><button type="button" class="btn btn-warning border w-100 py-3 fs-4 fw-bold shadow-sm" @onclick="BorrarUltimoNumpad" disabled="@guardandoVenta"><i class="bi bi-backspace"></i></button></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light p-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary px-4 py-2" @onclick="() => mostrarModalCobro = false" disabled="@guardandoVenta">Cancelar</button>
                        <button type="button" class="btn btn-success px-5 py-2 fw-bold fs-5 shadow"
                                disabled="@guardandoVenta"
                                @onclick="ProcesarCobroFinal">
                            @if (guardandoVenta)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                                <span>ACEPTAR E IMPRIMIR</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter]
    public string? ModoInicial { get; set; }

    private string modoVenta = "CONTADO";
    private bool cargando = true;
    private bool guardandoVenta = false;
    private bool mostrarCarrito = false;
    private bool mostrarModalClientes = false;
    private bool mostrarModalCobro = false;
    private bool mostrarModalStandby = false;
    private ElementReference categoriesContainer;

    private int categoriaSeleccionadaId = 0;
    private string categoriaSeleccionadaNombre = "";
    private string textoBusqueda = "";
    private string busquedaCliente = "";

    private List<CategoriaVenta> categorias = new();
    private List<ProductoVenta> todosProductos = new();
    private List<ProductoVenta> productosFiltrados = new();
    private List<ItemCarritoVenta> carrito = new();
    private List<ClienteVentaDto> listaClientes = new();
    private List<ClienteVentaDto> listaClientesFiltrados = new();

    private ClienteVentaDto? clienteSeleccionado;
    private double descuentoGlobal = 0;
    private string metodoPagoSeleccionado = "Efectivo";
    private double montoRecibido = 0;
    private double abonoInicial = 0;
    bool Bascula = false, AbrirTeclado = false;

    // Control de doble clic
    private bool _procesandoProducto = false;
    private string? _productoAnimandoId = null;

    // Debounce de búsqueda
    private System.Timers.Timer? _debounceBusqueda;

    private double SubtotalCalculado => carrito.Sum(x => x.Subtotal);
    private double TotalCalculado => Math.Max(0, SubtotalCalculado - descuentoGlobal);
    private double CambioCalculado => Math.Max(0, montoRecibido - TotalCalculado);

    // --- VARIABLES PAGO MIXTO ---
    private bool esPagoMixto = false;
    private string metodoPagoAgregando = "Efectivo";
    private double montoMetodoAgregando = 0;
    private Dictionary<string, double> pagosRealizados = new();

    private double SumaPagosMixtos => pagosRealizados.Sum(x => x.Value);
    private double RestanteMixto => Math.Max(0, TotalCalculado - SumaPagosMixtos);
    private double CambioMixto => Math.Max(0, SumaPagosMixtos - TotalCalculado);

    private string textoCapturaNumpad = "0";

    private double MontoRecibidoNumpad => double.TryParse(textoCapturaNumpad, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double val) ? val : 0;
    private double CambioCalculadoNumpad => Math.Max(0, MontoRecibidoNumpad - TotalCalculado);
    private bool categoriasCompactas = false;

    // ⭐ CONSTANTES PARA STAND-BY
    private const string KEY_STANDBY = "pos_ventas_standby";
    private const string KEY_CARRITO = "pos_carrito";
    private const string KEY_DESCUENTO = "pos_descuento";

    // ⭐ LISTA LOCAL DE VENTAS EN STAND-BY (para mostrar en modal)
    private List<VentaStandby> ventasStandby = new();
    private int ventasStandbyCount => ventasStandby.Count;

    // ⭐ CLASE PARA STAND-BY
    public class VentaStandby
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Modo { get; set; } = "CONTADO";
        public string? NombreCliente { get; set; }
        public string? IdCliente { get; set; }
        public List<ItemCarritoVenta> Items { get; set; } = new();
        public double Descuento { get; set; }
        public double Total { get; set; }
        public DateTime Fecha { get; set; } = DateTime.Now;
    }

    private void ToggleCategoriasCompactas() => categoriasCompactas = !categoriasCompactas;

    private void BorrarUltimoNumpad()
    {
        if (textoCapturaNumpad.Length > 1)
        {
            textoCapturaNumpad = textoCapturaNumpad.Substring(0, textoCapturaNumpad.Length - 1);
        }
        else
        {
            textoCapturaNumpad = "0";
        }

        ActualizarMontosDesdeNumpad();
    }

    private void LimpiarNumpad()
    {
        textoCapturaNumpad = "0";
        ActualizarMontosDesdeNumpad();
    }

    private void PresionarBillete(double valorBillete)
    {
        double actual = MontoRecibidoNumpad;
        textoCapturaNumpad = (actual + valorBillete).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        ActualizarMontosDesdeNumpad();
    }

    private void PresionarPagoExacto()
    {
        if (esPagoMixto)
        {
            montoMetodoAgregando = RestanteMixto;
            textoCapturaNumpad = RestanteMixto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }
        else
        {
            montoRecibido = TotalCalculado;
            textoCapturaNumpad = TotalCalculado.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private void ActualizarMontosDesdeNumpad()
    {
        double val = MontoRecibidoNumpad;
        montoRecibido = val;
        montoMetodoAgregando = val;
    }

    private async Task AbrirModalCobro()
    {
        if (carrito.Count == 0) return;

        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await MostrarToast($"Para {TituloModo} es obligatorio seleccionar un cliente.", "warning");
            await AbrirModalCliente();
            return;
        }
        metodoPagoSeleccionado = "Efectivo";
        metodoPagoAgregando = "Efectivo";
        esPagoMixto = false;
        pagosRealizados.Clear();

        montoRecibido = 0;
        textoCapturaNumpad = "0";
        montoMetodoAgregando = 0;
        abonoInicial = modoVenta == "APARTADO" ? Math.Round(TotalCalculado * 0.20, 2) : 0;
        mostrarCarrito = false;
        mostrarModalCobro = true;
    }

    private void LimpiarPagosMixtos()
    {
        pagosRealizados.Clear();
        montoMetodoAgregando = TotalCalculado;
    }

    private string TituloModo => modoVenta switch
    {
        "CREDITO" => "Venta a Crédito",
        "APARTADO" => "Venta en Apartado",
        _ => "Venta Normal (Contado)"
    };

    private string BadgeColorModo => modoVenta switch
    {
        "CREDITO" => "bg-warning text-dark",
        "APARTADO" => "bg-info text-white",
        _ => "bg-primary text-white"
    };

    private string IconoModo => modoVenta switch
    {
        "CREDITO" => "bi bi-credit-card-2-front-fill",
        "APARTADO" => "bi bi-bookmark-star-fill",
        _ => "bi bi-cash-stack"
    };

    private string HeaderColorCobro => modoVenta switch
    {
        "CREDITO" => "bg-warning text-dark",
        "APARTADO" => "bg-info",
        _ => "bg-success"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ModoInicial))
        {
            modoVenta = ModoInicial.ToUpper() switch
            {
                "CREDITO" => "CREDITO",
                "APARTADO" => "APARTADO",
                _ => "CONTADO"
            };
        }
        var configNegocio = await _cotizacionService.ObtenerConfiguracion();
        Bascula = configNegocio.Bascula;
        AbrirTeclado = configNegocio.AbrirTeclado;
        await CargarDatosIniciales();
    }

    private async Task OnDescuentoChanged()
    {
        if (descuentoGlobal < 0) descuentoGlobal = 0;
        if (descuentoGlobal > SubtotalCalculado) descuentoGlobal = SubtotalCalculado;

        await PersistirCarrito();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RecuperarCarrito();
            await CargarStandbyDesdeStorage();

            await JS.InvokeVoidAsync("eval", @"
                if (!window.__posAtajos) {
                    window.__posAtajos = true;
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'F2') {
                            e.preventDefault();
                            document.querySelector('.checkout-footer .btn-success')?.click();
                        }
                        if (e.key === 'F4') {
                            e.preventDefault();
                            document.querySelector('.pos-header-bar .btn-outline-primary')?.click();
                        }
                        if (e.key === 'Escape') {
                            document.querySelectorAll('.modal .btn-close').forEach(b => b.click());
                        }
                        if (e.key === 'Delete' && e.ctrlKey) {
                            e.preventDefault();
                            if (confirm('¿Vaciar el carrito?')) {
                                document.querySelector('.checkout-header .btn-outline-danger')?.click();
                            }
                        }
                    });
                }
            ");
        }
    }

    // ============================================================
    // ⭐ LÓGICA DE VENTAS EN STAND-BY (NUEVA PESTAÑA)
    // ============================================================

    /// <summary>
    /// Guarda la venta actual como stand-by (si tiene items) y abre
    /// http://localhost:5000/ventas en una nueva pestaña.
    /// </summary>
    private async Task AbrirNuevaVentaEnPestana()
    {
        try
        {
            // 1. Si hay items en el carrito, guardar como stand-by
            if (carrito.Count > 0)
            {
                var nuevoStandby = new VentaStandby
                {
                    Modo = modoVenta,
                    NombreCliente = clienteSeleccionado?.Nombre,
                    IdCliente = clienteSeleccionado?.Id,
                    Items = new List<ItemCarritoVenta>(carrito),
                    Descuento = descuentoGlobal,
                    Total = TotalCalculado
                };

                ventasStandby.Add(nuevoStandby);
                await PersistirStandby();

                // 2. Limpiar la venta actual (ya está en stand-by)
                carrito.Clear();
                descuentoGlobal = 0;
                clienteSeleccionado = null;
                await PersistirCarrito();

                await MostrarToast($"Venta guardada en espera ({ventasStandbyCount} pendientes)", "info");
            }

            // 3. Abrir nueva pestaña
            await JS.InvokeVoidAsync("open", "http://localhost:5000/ventas", "_blank");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await MostrarToast($"Error al abrir nueva pestaña: {ex.Message}", "danger");
        }
    }

    private async Task CargarStandbyDesdeStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", KEY_STANDBY);
            if (!string.IsNullOrEmpty(json))
            {
                var lista = System.Text.Json.JsonSerializer.Deserialize<List<VentaStandby>>(json);
                if (lista != null)
                {
                    ventasStandby = lista;
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    private async Task PersistirStandby()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(ventasStandby);
            await JS.InvokeVoidAsync("localStorage.setItem", KEY_STANDBY, json);
        }
        catch { }
    }

    private void AbrirModalStandby()
    {
        mostrarModalStandby = true;
    }

    private async Task RecuperarStandby(VentaStandby v)
    {
        // Si hay una venta actual con items, primero la guardamos en stand-by
        if (carrito.Count > 0)
        {
            var actual = new VentaStandby
            {
                Modo = modoVenta,
                NombreCliente = clienteSeleccionado?.Nombre,
                IdCliente = clienteSeleccionado?.Id,
                Items = new List<ItemCarritoVenta>(carrito),
                Descuento = descuentoGlobal,
                Total = TotalCalculado
            };
            ventasStandby.Add(actual);
        }

        // Restaurar la venta seleccionada
        carrito = new List<ItemCarritoVenta>(v.Items);
        descuentoGlobal = v.Descuento;
        modoVenta = v.Modo;
        clienteSeleccionado = null; // El ID se conserva pero no tenemos el objeto completo

        // Quitar de la lista de stand-by
        ventasStandby.RemoveAll(x => x.Id == v.Id);

        await PersistirCarrito();
        await PersistirStandby();

        mostrarModalStandby = false;
        await MostrarToast("Venta recuperada del stand-by", "success");
        StateHasChanged();
    }

    private async Task EliminarStandby(string id)
    {
        ventasStandby.RemoveAll(x => x.Id == id);
        await PersistirStandby();
        StateHasChanged();
    }

    // ============================================================

    private async Task RecuperarCarrito()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", KEY_CARRITO);
            if (!string.IsNullOrEmpty(json))
            {
                var items = System.Text.Json.JsonSerializer.Deserialize<List<ItemCarritoVenta>>(json);
                if (items != null && items.Count > 0)
                {
                    carrito = items;
                }
            }

            var desc = await JS.InvokeAsync<string?>("localStorage.getItem", KEY_DESCUENTO);
            if (double.TryParse(desc, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
            {
                descuentoGlobal = d;
            }

            StateHasChanged();
        }
        catch { }
    }

    private async Task PersistirCarrito()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(carrito);
            await JS.InvokeVoidAsync("localStorage.setItem", KEY_CARRITO, json);
            await JS.InvokeVoidAsync("localStorage.setItem", KEY_DESCUENTO,
                descuentoGlobal.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
        catch { }
    }

    private void OnBusquedaChanged()
    {
        _debounceBusqueda?.Stop();
        _debounceBusqueda?.Dispose();
        _debounceBusqueda = new System.Timers.Timer(150);
        _debounceBusqueda.AutoReset = false;
        _debounceBusqueda.Elapsed += (s, e) =>
        {
            InvokeAsync(() =>
            {
                FiltrarProductos();
                StateHasChanged();
            });
        };
        _debounceBusqueda.Start();
    }

    private async Task ScrollCategorias(int px)
    {
        await JS.InvokeVoidAsync("scrollElementBy", categoriesContainer, px);
    }

    private async Task OnCategoriasWheel(WheelEventArgs e)
    {
        if (e.DeltaY != 0)
        {
            await JS.InvokeVoidAsync("scrollElementBy", categoriesContainer, e.DeltaY > 0 ? 180 : -180);
        }
    }

    private async Task CargarDatosIniciales()
    {
        cargando = true;
        try
        {
            categorias = await VentaService.ObtenerCategoriasAsync();
            todosProductos = await VentaService.ObtenerProductosAsync();
            productosFiltrados = todosProductos;
        }
        catch (Exception ex)
        {
            await MostrarToast($"Error al cargar catálogo: {ex.Message}", "danger");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ProcesarBusquedaOEscaneo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda)) return;

            string input = textoBusqueda.Trim();

            if (input.StartsWith("PRE:", StringComparison.OrdinalIgnoreCase))
            {
                await ProcesarPreventaQR(input);
                textoBusqueda = "";
                return;
            }

            var productoEncontrado = todosProductos.FirstOrDefault(p =>
                p.Id.Equals(input, StringComparison.OrdinalIgnoreCase));

            if (productoEncontrado != null)
            {
                await AgregarProductoConBascula(productoEncontrado);
                textoBusqueda = "";
            }
            else
            {
                FiltrarProductos();
            }
        }
    }

    private async Task ProcesarPreventaQR(string cadenaQR)
    {
        try
        {
            string datos = cadenaQR.Substring(4);
            string[] items = datos.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var item in items)
            {
                string[] partes = item.Split(':');
                if (partes.Length == 2)
                {
                    string idProd = partes[0];
                    if (double.TryParse(partes[1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double cant))
                    {
                        var prod = await VentaService.BuscarProductoPorIdAsync(idProd);
                        if (prod != null)
                        {
                            AgregarDirectoAlCarrito(prod, cant);
                        }
                    }
                }
            }
            await PersistirCarrito();
        }
        catch (Exception ex)
        {
            await MostrarToast($"Error al procesar QR: {ex.Message}", "danger");
        }
    }

    private async Task<double> ObtenerPesoBasculaLocalAsync()
    {
        if (!Bascula) return 1;

        try
        {
            var res = await Http.GetStringAsync("http://localhost:8080/peso/");
            if (!string.IsNullOrEmpty(res) && res != "ERROR")
            {
                if (double.TryParse(res, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double peso))
                {
                    return peso > 0 ? peso : 1;
                }
            }
        }
        catch { }
        return 1;
    }

    private async Task AgregarProductoConBascula(ProductoVenta prod)
    {
        if (_procesandoProducto) return;

        _procesandoProducto = true;
        _productoAnimandoId = prod.Id;
        StateHasChanged();

        try
        {
            double pesoBasc = await ObtenerPesoBasculaLocalAsync();
            AgregarDirectoAlCarrito(prod, pesoBasc);
            await PersistirCarrito();
        }
        finally
        {
            await Task.Delay(180);
            _productoAnimandoId = null;
            _procesandoProducto = false;
            StateHasChanged();
        }
    }

    private void AgregarDirectoAlCarrito(ProductoVenta prod, double cantidad)
    {
        var existente = carrito.FirstOrDefault(x =>
            x.ProductoId == prod.Id && string.IsNullOrEmpty(x.Comentario));

        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new ItemCarritoVenta
            {
                ProductoId = prod.Id,
                Nombre = prod.Nombre,
                Precio = prod.Precio,
                Cantidad = cantidad,
                Costo = prod.CostoTotal,
                Categoria = prod.Categoria,
                Existencia = prod.Existencia,
                Iva = prod.Iva
            });
        }
    }

    private async Task CambiarModo(string nuevoModo)
    {
        modoVenta = nuevoModo;

        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await AbrirModalCliente();
        }
        StateHasChanged();
    }

    private void SeleccionarCategoria(string nombreCat, int idCat = 0)
    {
        categoriaSeleccionadaNombre = nombreCat;
        categoriaSeleccionadaId = idCat;
        FiltrarProductos();
    }

    private void FiltrarProductos()
    {
        var lista = todosProductos.AsEnumerable().Where(x => !x.EsInsumo);

        if (!string.IsNullOrWhiteSpace(categoriaSeleccionadaNombre))
        {
            lista = lista.Where(x =>
                x.Categoria.Equals(categoriaSeleccionadaNombre, StringComparison.OrdinalIgnoreCase) ||
                (categoriaSeleccionadaId > 0 && x.IdCategoria == categoriaSeleccionadaId));
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var terminos = textoBusqueda.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            foreach (var t in terminos)
            {
                var tLower = t.ToLowerInvariant();
                lista = lista.Where(x =>
                    x.Nombre.ToLowerInvariant().Contains(tLower) ||
                    x.Id.ToLowerInvariant().Contains(tLower));
            }

            productosFiltrados = lista
                .OrderByDescending(x => x.Nombre.StartsWith(textoBusqueda, StringComparison.OrdinalIgnoreCase))
                .ThenBy(x => x.Nombre)
                .ToList();
        }
        else
        {
            productosFiltrados = lista.ToList();
        }
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        FiltrarProductos();
        _ = JS.InvokeVoidAsync("focusBuscadorPOS");
    }

    private async Task ModificarCantidadCarrito(ItemCarritoVenta item, double delta)
    {
        item.Cantidad += delta;
        if (item.Cantidad <= 0)
        {
            carrito.Remove(item);
        }
        await PersistirCarrito();
    }

    private async Task EliminarDelCarrito(ItemCarritoVenta item)
    {
        carrito.Remove(item);
        await PersistirCarrito();
        await MostrarToast($"'{item.Nombre}' eliminado", "warning");
    }

    private async Task VaciarCarrito()
    {
        if (carrito.Count == 0) return;
        carrito.Clear();
        descuentoGlobal = 0;
        await PersistirCarrito();
        await MostrarToast("Carrito vaciado", "info");
    }

