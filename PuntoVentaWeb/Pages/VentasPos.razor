    private async Task ProcesarCobroFinal()
    {
        if (guardandoVenta) return;
        if (modoVenta != "CONTADO" && clienteSeleccionado == null)
        {
            await MostrarToast("Debes seleccionar un cliente.", "warning");
            return;
        }

        if (modoVenta == "CONTADO")
        {
            if (esPagoMixto)
            {
                if (SumaPagosMixtos < TotalCalculado)
                {
                    await MostrarToast($"Falta cubrir el total. Restante: ${RestanteMixto:N2}", "warning");
                    return;
                }
            }
            else if (metodoPagoSeleccionado == "Efectivo" && montoRecibido < TotalCalculado)
            {
                await MostrarToast("El monto recibido es menor al total a pagar.", "warning");
                return;
            }
        }

        guardandoVenta = true;
        try
        {
            string metodoFinal = esPagoMixto ? "MIXTO" : metodoPagoSeleccionado;

            double efectivoEntregado = esPagoMixto
                ? pagosRealizados.Where(x => x.Key.Contains("Efectivo", StringComparison.OrdinalIgnoreCase)).Sum(x => x.Value)
                : montoRecibido;

            double cambioFinal = esPagoMixto ? CambioMixto : CambioCalculado;

            var req = new VentaGuardarRequest
            {
                TipoVenta = modoVenta,
                Folio = "",
                IdCliente = clienteSeleccionado?.Id ?? "0",
                NombreCliente = clienteSeleccionado?.Nombre ?? "PUBLICO EN GENERAL",
                DireccionCliente = clienteSeleccionado?.Direccion ?? "",
                TelefonoCliente = clienteSeleccionado?.Telefono ?? "",
                Subtotal = SubtotalCalculado,
                Descuento = descuentoGlobal,
                Total = TotalCalculado,
                MetodoPago = metodoFinal,
                MontoRecibido = efectivoEntregado,
                Cambio = cambioFinal,
                AbonoInicial = abonoInicial,
                Restante = TotalCalculado - abonoInicial,
                Observaciones = "",
                DatosCotizacion = "",
                FolioCotizacion = "",
                IdUsuario = "1",
                Usuario = "cajero 1",
                Items = new List<ItemCarritoVenta>(carrito),

                PagosDetalle = esPagoMixto
                    ? new Dictionary<string, double>(pagosRealizados)
                    : new Dictionary<string, double> { { metodoPagoSeleccionado, TotalCalculado } }
            };

            var resultado = await VentaService.GuardarVentaAsync(req);

            if (resultado.Exito)
            {
                req.Folio = resultado.FolioFinal;
                bool deseaImprimir = await JS.InvokeAsync<bool>("confirm", "¿Desea imprimir el ticket de esta venta?");

                if (deseaImprimir)
                {
                    try
                    {
                        await ImpresionService.ImprimirTicketVentaAsync(req);
                    }
                    catch (Exception exPrint)
                    {
                        System.Console.WriteLine($"Error al imprimir ticket: {exPrint.Message}");
                        await MostrarToast("Venta guardada, pero falló la impresión.", "warning");
                    }

                }
                await MostrarToast($"¡{TituloModo} registrada! Folio: {resultado.FolioFinal}", "success");

                carrito.Clear();
                pagosRealizados.Clear();
                descuentoGlobal = 0;
                esPagoMixto = false;

                if (modoVenta == "CONTADO") clienteSeleccionado = null;
                mostrarModalCobro = false;
                await PersistirCarrito();

                todosProductos = await VentaService.ObtenerProductosAsync();
                FiltrarProductos();

            }
            else
            {
                await MostrarToast($"Error: {resultado.Mensaje}", "danger");
            }
        }
        catch (Exception ex)
        {
            await MostrarToast($"Ocurrió un error: {ex.Message}", "danger");
        }
        finally
        {
            guardandoVenta = false;
        }
    }

    private async Task MostrarToast(string mensaje, string tipo = "success")
    {
        try
        {
            await JS.InvokeVoidAsync("mostrarToast", mensaje, tipo);
        }
        catch
        {
            await JS.InvokeVoidAsync("alert", mensaje);
        }
    }

    private async Task FiltrarDesdeLupa()
    {
        textoBusqueda = await JS.InvokeAsync<string>("obtenerValorBuscadorPOS");

        FiltrarProductos();
        StateHasChanged();
        await JS.InvokeVoidAsync("focusBuscadorPOS");
    }

    private void AgregarPagoMixto()
    {
        if (montoMetodoAgregando <= 0) return;

        if (metodoPagoAgregando != "Efectivo" && montoMetodoAgregando > RestanteMixto)
        {
            _ = MostrarToast($"El pago no puede ser mayor al restante (${RestanteMixto:N2}).", "warning");
            return;
        }

        if (pagosRealizados.ContainsKey(metodoPagoAgregando))
            pagosRealizados[metodoPagoAgregando] += montoMetodoAgregando;
        else
            pagosRealizados.Add(metodoPagoAgregando, montoMetodoAgregando);

        textoCapturaNumpad = "0";
        montoMetodoAgregando = 0;
    }

    private void EliminarPagoMixto(string metodo)
    {
        if (pagosRealizados.ContainsKey(metodo))
        {
            pagosRealizados.Remove(metodo);
            textoCapturaNumpad = "0";
            montoMetodoAgregando = 0;
        }
    }

    private void TogglePagoMixto(ChangeEventArgs e)
    {
        esPagoMixto = (bool)(e.Value ?? false);
        pagosRealizados.Clear();
        textoCapturaNumpad = "0";
        montoRecibido = 0;
        montoMetodoAgregando = 0;
    }
    private void PresionarNumpad(string digito)
    {
        if (digito == ".")
        {
            if (!textoCapturaNumpad.Contains("."))
                textoCapturaNumpad += ".";
        }
        else
        {
            if (textoCapturaNumpad == "0")
                textoCapturaNumpad = digito;
            else
                textoCapturaNumpad += digito;
        }

        ActualizarMontosDesdeNumpad();
    }
    private async Task OnCantidadChanged(ItemCarritoVenta item)
    {
        // Si la cantidad se borra o se pone en 0 o negativo, lo eliminamos
        if (item.Cantidad <= 0)
        {
            carrito.Remove(item);
            await MostrarToast($"'{item.Nombre}' eliminado", "warning");
        }

        // Forzamos la actualización de la interfaz y guardamos
        await PersistirCarrito();
        StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        _debounceBusqueda?.Stop();
        _debounceBusqueda?.Dispose();
        await Task.CompletedTask;
    }
}