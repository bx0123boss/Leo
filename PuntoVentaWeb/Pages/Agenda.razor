@page "/agenda"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject AgendaService AgendaService
@inject NavigationManager Nav

<div class="container-fluid py-3 bg-light min-vh-100">
    @* ================= BARRA SUPERIOR ================= *@
    <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm border mb-3 gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-info text-white p-2 fs-5">
                <i class="bi bi-calendar2-week-fill"></i>
            </span>
            <div>
                <h4 class="m-0 fw-bold text-dark">Agenda de Entregas y Apartados</h4>
                <small class="text-muted">Control mensual de pedidos programados</small>
            </div>
        </div>

        @* Controles de Mes *@
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary fw-bold" @onclick="MesAnterior">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-primary fw-bold px-3" @onclick="IrAHoy">
                Hoy
            </button>
            <h5 class="m-0 fw-bold text-capitalize px-2 text-center" style="min-width: 170px;">
                @fechaMesActual.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-MX"))
            </h5>
            <button class="btn btn-outline-secondary fw-bold" @onclick="MesSiguiente">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-info text-white fw-bold shadow-sm" @onclick='() => Nav.NavigateTo("/ventas/APARTADO")'>
                <i class="bi bi-plus-circle-fill me-1"></i> Nuevo Apartado
            </button>
            <button class="btn btn-outline-dark fw-bold" @onclick='() => Nav.NavigateTo("/ventas")'>
                <i class="bi bi-shop me-1"></i> Punto de Venta
            </button>
        </div>
    </div>

    @* ================= TARJETAS RESUMEN DEL MES ================= *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-2 px-3 border-start border-4 border-primary">
                <div class="small text-muted fw-semibold">Entregas del Mes</div>
                <div class="fs-4 fw-bold text-dark">@apartadosMes.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-2 px-3 border-start border-4 border-warning">
                <div class="small text-muted fw-semibold">Con Saldo Pendiente</div>
                <div class="fs-4 fw-bold text-warning">@apartadosMes.Count(x => !x.EstaLiquidado)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-2 px-3 border-start border-4 border-success">
                <div class="small text-muted fw-semibold">Liquidados</div>
                <div class="fs-4 fw-bold text-success">@apartadosMes.Count(x => x.EstaLiquidado)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-2 px-3 border-start border-4 border-danger">
                <div class="small text-muted fw-semibold">Por Cobrar en el Mes</div>
                <div class="fs-4 fw-bold text-danger">$@apartadosMes.Sum(x => x.Restante).ToString("N2")</div>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status"></div>
            <p class="mt-2 fw-semibold text-muted">Cargando agenda...</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @* ================= CALENDARIO MENSUAL (IZQUIERDA) ================= *@
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm overflow-hidden">
                    @* Encabezado de días de la semana *@
                    <div class="agenda-grid-header bg-dark text-white text-center fw-bold py-2 small">
                        <div>LUN</div>
                        <div>MAR</div>
                        <div>MIÉ</div>
                        <div>JUE</div>
                        <div>VIE</div>
                        <div>SÁB</div>
                        <div>DOM</div>
                    </div>

                    @* Celdas de los días *@
                    <div class="agenda-grid-body bg-white">
                        @foreach (var celda in celdasCalendario)
                        {
                            if (celda == null)
                            {
                                <div class="agenda-cell empty bg-light"></div>
                            }
                            else
                            {
                                var dia = celda.Value;
                                var pedidosDia = apartadosMes.Where(a => a.FechaEntrega?.Date == dia.Date).ToList();
                                bool esSeleccionado = diaSeleccionado.Date == dia.Date;
                                bool esHoy = dia.Date == DateTime.Today;

                                <div class="agenda-cell @(esSeleccionado ? "selected" : "") @(esHoy ? "today" : "")"
                                     @onclick="() => SeleccionarDia(dia)">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="day-number @(esHoy ? "badge rounded-pill bg-primary" : "fw-bold text-dark")">
                                            @dia.Day
                                        </span>
                                        @if (pedidosDia.Count > 0)
                                        {
                                            <span class="badge bg-info text-white rounded-pill extra-small">
                                                @pedidosDia.Count
                                            </span>
                                        }
                                    </div>

                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var ped in pedidosDia.Take(2))
                                        {
                                            string colorBadge = ped.EstaLiquidado
                                            ? "bg-success-subtle text-success border-success"
                                            : (ped.EstaVencido ? "bg-danger-subtle text-danger border-danger" : "bg-warning-subtle text-dark border-warning");

                                            <div class="pedido-pill border rounded px-1 text-truncate @colorBadge"
                                                 title="@ped.NombreCliente - Restante: $@ped.Restante.ToString("N2")">
                                                <small class="fw-bold">#@ped.Folio</small> <small>@ped.NombreCliente</small>
                                            </div>
                                        }
                                        @if (pedidosDia.Count > 2)
                                        {
                                            <small class="text-muted fw-bold text-center" style="font-size: 0.7rem;">
                                                +@(pedidosDia.Count - 2) más...
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            @* ================= DETALLE DEL DÍA SELECCIONADO (DERECHA) ================= *@
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="m-0 fw-bold text-capitalize">
                                <i class="bi bi-calendar-event me-1"></i>
                                @diaSeleccionado.ToString("dddd dd 'de' MMMM", new System.Globalization.CultureInfo("es-MX"))
                            </h6>
                        </div>
                        <span class="badge bg-white text-dark fw-bold">@PedidosDiaSeleccionado.Count pedido(s)</span>
                    </div>

                    <div class="card-body p-3 overflow-auto" style="max-height: 68vh;">
                        @if (PedidosDiaSeleccionado.Count == 0)
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-calendar-check fs-1 d-block mb-2"></i>
                                <p class="m-0 fw-semibold">Sin entregas programadas para este día.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in PedidosDiaSeleccionado)
                            {
                                <div class="card mb-3 border shadow-sm">
                                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold text-primary">Folio #@item.Folio</span>
                                        @if (item.EstaLiquidado)
                                        {
                                            <span class="badge bg-success">LIQUIDADO</span>
                                        }
                                        else if (item.EstaVencido)
                                        {
                                            <span class="badge bg-danger">VENCIDO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">PENDIENTE</span>
                                        }
                                    </div>

                                    <div class="card-body p-2 px-3">
                                        <div class="fw-bold text-dark mb-1">
                                            <i class="bi bi-person-fill text-secondary me-1"></i>@item.NombreCliente
                                        </div>
                                        <div class="extra-small text-muted mb-2">
                                            Apartado el: @item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                        @* Lista de productos de dbo.VentasApartados *@
                                        <div class="bg-light rounded p-2 mb-2 border">
                                            <div class="extra-small fw-bold text-muted mb-1">ARTÍCULOS APARTADOS:</div>
                                            @if (item.Productos.Count == 0)
                                            {
                                                <small class="text-muted">Sin detalle de productos</small>
                                            }
                                            else
                                            {
                                                <ul class="list-unstyled m-0 small">
                                                    @foreach (var prod in item.Productos)
                                                    {
                                                        <li class="d-flex justify-content-between border-bottom py-1">
                                                            <span><strong>@prod.Cantidad</strong> x @prod.Producto</span>
                                                            <span class="fw-semibold">$@prod.MontoTotal.ToString("N2")</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>

                                        @* Totales *@
                                        <div class="d-flex justify-content-between small">
                                            <span class="text-muted">Total Apartado:</span>
                                            <span class="fw-bold">$@item.MontoTotal.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between small">
                                            <span class="text-muted">Abonado:</span>
                                            <span class="fw-bold text-success">$@item.Abono.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between border-top pt-1 mt-1">
                                            <span class="fw-bold">Restante:</span>
                                            <span class="fw-bold fs-5 @(item.EstaLiquidado ? "text-success" : "text-danger")">
                                                $@item.Restante.ToString("N2")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .agenda-grid-header,
    .agenda-grid-body {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }

    .agenda-cell {
        min-height: 105px;
        border-right: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
        padding: 6px;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .agenda-cell:hover:not(.empty) {
            background-color: #f1f8ff;
        }

        .agenda-cell.selected {
            background-color: #e3f2fd;
            outline: 2px solid #0dcaf0;
            outline-offset: -2px;
        }

        .agenda-cell.today {
            background-color: #fffdf0;
        }

    .pedido-pill {
        font-size: 0.72rem;
        line-height: 1.2;
        padding: 2px 4px;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    private DateTime fechaMesActual = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime diaSeleccionado = DateTime.Today;
    private bool cargando = true;

    private List<AgendaApartadoDto> apartadosMes = new();
    private List<DateTime?> celdasCalendario = new();

    private List<AgendaApartadoDto> PedidosDiaSeleccionado =>
        apartadosMes.Where(a => a.FechaEntrega?.Date == diaSeleccionado.Date).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarMesAsync();
    }

    private async Task CargarMesAsync()
    {
        cargando = true;
        ConstruirCuadriculaCalendario();
        apartadosMes = await AgendaService.ObtenerApartadosPorMesAsync(fechaMesActual.Year, fechaMesActual.Month);
        cargando = false;
    }

    private void ConstruirCuadriculaCalendario()
    {
        celdasCalendario.Clear();
        int diasEnMes = DateTime.DaysInMonth(fechaMesActual.Year, fechaMesActual.Month);

        // Convertir DayOfWeek para que Lunes = 0 ... Domingo = 6
        int primerDiaSemana = ((int)fechaMesActual.DayOfWeek + 6) % 7;

        for (int i = 0; i < primerDiaSemana; i++)
        {
            celdasCalendario.Add(null);
        }

        for (int dia = 1; dia <= diasEnMes; dia++)
        {
            celdasCalendario.Add(new DateTime(fechaMesActual.Year, fechaMesActual.Month, dia));
        }

        while (celdasCalendario.Count % 7 != 0)
        {
            celdasCalendario.Add(null);
        }
    }

    private void SeleccionarDia(DateTime dia)
    {
        diaSeleccionado = dia;
    }

    private async Task MesAnterior()
    {
        fechaMesActual = fechaMesActual.AddMonths(-1);
        diaSeleccionado = fechaMesActual;
        await CargarMesAsync();
    }

    private async Task MesSiguiente()
    {
        fechaMesActual = fechaMesActual.AddMonths(1);
        diaSeleccionado = fechaMesActual;
        await CargarMesAsync();
    }

    private async Task IrAHoy()
    {
        fechaMesActual = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        diaSeleccionado = DateTime.Today;
        await CargarMesAsync();
    }
}